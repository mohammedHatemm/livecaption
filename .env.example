# ===========================================
# CineAI Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ===========================================
# Database Configuration
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=livecaption
DB_USERNAME=your_db_username
DB_PASSWORD=your_secure_db_password

# ===========================================
# JWT Configuration
# ===========================================
# Generate with: openssl rand -base64 64
JWT_SECRET=your-256-bit-secret-key-base64-encoded-minimum-32-characters
JWT_EXPIRATION=604800000

# ===========================================
# Server Configuration
# ===========================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ===========================================
# JPA Configuration
# ===========================================
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# ===========================================
# CORS Configuration
# ===========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ===========================================
# TMDB API (Required)
# ===========================================
# Get your API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your-tmdb-api-key

# ===========================================
# AI Services (Optional - choose one or more)
# ===========================================
# Default provider: 'openai' or 'gemini'
AI_DEFAULT_PROVIDER=openai

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# Google Gemini - https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Groq (for Whisper) - https://console.groq.com
GROQ_API_KEY=your-groq-api-key

# ===========================================
# Redis Configuration (Optional)
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================================
# Vector Database (Optional)
# ===========================================
# Pinecone - https://www.pinecone.io
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-pinecone-environment
PINECONE_INDEX=movie-embeddings
